# Leave empty to call same-origin Next.js route handlers (/api/...).
# Set to your FastAPI origin to call it directly, e.g. http://localhost:8000
# (FastAPI needs CORS enabled for the Next.js origin.)
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds before the UI falls back to demo data.
NEXT_PUBLIC_API_TIMEOUT_MS=4000

# Set to "true" to skip the network entirely, e.g. for a guaranteed-offline demo.
NEXT_PUBLIC_FORCE_MOCK=false
